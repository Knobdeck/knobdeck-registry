          "value": "idle",
          "label": "Not speaking",
          "icon": "volume-x"
        },
        {
          "value": "speaking",
          "label": "Speaking",
          "icon": "square"
        }
      ]
    },
    "voice": {
      "type": "toggle",
      "label": "Use Voice",
      "icon": "user-round",
      "platforms": [
        "linux",
        "macos",
