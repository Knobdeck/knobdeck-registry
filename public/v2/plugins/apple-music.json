  "actions": {
    "now-playing": {
      "type": "button",
      "label": "Now Playing",
      "icon": "music",
      "platforms": [
        "macos"
      ],
      "inputs": [
        {
          "key": "artwork",
          "type": "checkbox",
          "label": "Show the artwork",
          "default": true
        },
        {
          "key": "press",
          "type": "checkbox",
          "label": "Press to play / pause",
          "default": true
        }
      ]
    },
    "play-pause": {
      "type": "toggle",
      "label": "Play / Pause",
      "icon": "play",
      "platforms": [
        "macos"
      ],
      "inputs": [],
      "states": [
        {
          "value": "paused",
          "label": "Play",
          "icon": "play"
        },
        {
          "value": "playing",
          "label": "Pause",
          "icon": "pause"
        }
      ]
    },
    "next": {
      "type": "button",
      "label": "Next Track",
      "icon": "skip-forward",
      "platforms": [
        "macos"
      ],
      "inputs": []
    },
    "previous": {
      "type": "button",
      "label": "Previous Track",
      "icon": "skip-back",
      "platforms": [
        "macos"
      ],
      "inputs": []
    },
    "shuffle": {
      "type": "toggle",
      "label": "Shuffle",
      "icon": "shuffle",
      "platforms": [
        "macos"
      ],
      "inputs": [],
      "states": [
        {
          "value": "off",
          "label": "Shuffle off",
          "icon": "shuffle"
        },
        {
          "value": "on",
          "label": "Shuffle on",
          "icon": "shuffle"
        }
      ]
    },
    "repeat": {
      "type": "toggle",
      "label": "Repeat",
      "icon": "repeat",
      "platforms": [
        "macos"
      ],
      "inputs": [],
      "states": [
        {
          "value": "off",
          "label": "Repeat off",
          "icon": "repeat"
        },
        {
          "value": "all",
          "label": "Repeat all",
          "icon": "repeat"
        },
        {
          "value": "one",
          "label": "Repeat one",
          "icon": "repeat-1"
        }
      ]
    },
    "favorite": {
      "type": "toggle",
      "label": "Favorite Track",
      "icon": "heart",
      "platforms": [
        "macos"
      ],
      "inputs": [],
      "states": [
        {
          "value": "off",
          "label": "Favorite",
          "icon": "heart"
        },
        {
          "value": "on",
          "label": "Favorited",
          "icon": "heart"
        }
      ]
    },
    "volume": {
      "type": "slider",
      "label": "Music Volume",
      "icon": "volume-2",
      "platforms": [
        "macos"
      ],
      "inputs": [
        {
          "key": "step",
          "type": "text",
          "label": "Percent per dial step",
          "default": "5"
        }
      ],
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    "play-playlist": {
      "type": "button",
      "label": "Play Playlist",
      "icon": "list-music",
      "platforms": [
        "macos"
      ],
      "inputs": [
        {
          "key": "playlist",
          "type": "combobox",
          "label": "Playlist"
        },
        {
          "key": "shuffle",
          "type": "checkbox",
          "label": "Shuffle it",
          "default": false
        }
