        {
          "key": "server",
          "type": "combobox",
          "label": "Neovim",
          "default": "__auto__"
        },
        {
          "key": "option",
          "type": "select",
          "label": "Option",
          "default": "wrap",
          "options": [
            "wrap",
            "relativenumber",
            "number",
            "spell",
            "list",
            "cursorline",
            "hlsearch",
            "ignorecase",
            "expandtab",
            "custom"
          ]
        },
        {
          "key": "custom",
          "type": "text",
          "label": "Option name",
          "showIf": {
