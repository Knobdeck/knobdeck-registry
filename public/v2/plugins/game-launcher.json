  "actions": {
    "launch": {
      "type": "button",
      "label": "Launch Game",
      "icon": "gamepad-2",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "game",
          "type": "select",
          "label": "Game"
        },
        {
          "key": "show_name",
          "type": "checkbox",
          "label": "Show the game's name",
          "default": true
        }
      ]
    },
    "games-wheel": {
      "type": "wheel",
      "label": "Games Wheel",
      "icon": "layout-grid",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "store",
          "type": "select",
          "label": "Store",
          "default": "all",
          "options": [
            "all",
            "steam",
            "heroic",
            "lutris"
          ]
        },
        {
          "key": "sort",
          "type": "select",
          "label": "Show",
          "default": "recent",
          "options": [
            "recent",
            "name"
          ]
        }
      ]
    },
    "open-page": {
      "type": "button",
      "label": "Open Launcher Page",
      "icon": "library",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "page",
          "type": "select",
          "label": "Page",
          "default": "steam-library",
          "options": [
            "steam-library",
            "steam-store",
            "steam-friends",
            "steam-downloads",
            "steam-settings",
            "steam-bigpicture"
          ]
        }
      ]
    },
    "close": {
      "type": "button",
      "label": "Close Game",
      "icon": "circle-x",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "game",
          "type": "select",
          "label": "Game",
          "default": "__running__"
        },
        {
          "key": "force",
          "type": "select",
          "label": "If it doesn't close",
          "default": "5",
          "options": [
            "5",
            "15",
            "30",
            "never"
          ]
        }
      ]
    }
  },
  "companions": []
}
