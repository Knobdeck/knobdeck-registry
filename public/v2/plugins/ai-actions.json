  "actions": {
    "run": {
      "type": "button",
      "label": "AI Action",
      "icon": "sparkles",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "preset",
          "type": "select",
          "label": "Do",
          "default": "fix",
          "options": [
            "fix",
            "rewrite",
            "shorter",
            "professional",
            "friendly",
            "bullets",
            "translate",
            "summarize",
            "explain",
            "explain-code",
            "reply",
            "custom"
          ]
        },
        {
          "key": "prompt",
          "type": "textarea",
          "label": "Prompt",
          "showIf": {
            "key": "preset",
            "equals": "custom"
          }
        },
        {
          "key": "language",
          "type": "text",
          "label": "Translate into",
          "default": "English",
          "showIf": {
            "key": "preset",
            "equals": "translate"
          }
        },
        {
          "key": "output",
          "type": "select",
          "label": "Put the answer",
          "default": "auto",
          "options": [
            "auto",
            "replace",
            "copy",
            "show"
          ]
        },
        {
          "key": "no_clipboard",
          "type": "checkbox",
          "label": "Don't fall back to the clipboard when nothing is selected"
        }
      ]
    },
    "wheel": {
      "type": "wheel",
      "label": "AI Actions Wheel",
      "icon": "wand-sparkles",
