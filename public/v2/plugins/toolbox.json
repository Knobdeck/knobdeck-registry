  "actions": {
    "counter": {
      "type": "button",
      "label": "Counter",
      "icon": "hash",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "name",
          "type": "text",
          "label": "Counter name",
          "default": "Counter"
        },
        {
          "key": "do",
          "type": "select",
          "label": "Press",
          "default": "add",
          "options": [
            "add",
            "subtract",
            "reset"
          ]
        },
        {
          "key": "step",
          "type": "text",
          "label": "By",
          "default": "1",
          "showIf": {
            "key": "do",
            "in": [
              "add",
              "subtract"
            ]
          }
        },
        {
          "key": "reset_to",
          "type": "text",
          "label": "Reset to",
          "default": "0",
          "showIf": {
            "key": "do",
            "equals": "reset"
          }
        }
      ]
    },
    "counter-dial": {
      "type": "slider",
      "label": "Counter Dial",
      "icon": "hash",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "name",
          "type": "text",
          "label": "Counter name",
          "default": "Counter"
        },
        {
          "key": "step",
          "type": "text",
          "label": "Per tick",
          "default": "1"
        }
      ],
      "min": -999999,
      "max": 999999,
      "step": 1,
      "unit": null
    },
    "dice": {
      "type": "button",
      "label": "Roll Dice",
      "icon": "dices",
