      "inputs": [
        {
          "key": "sides",
          "type": "select",
          "label": "Die",
          "default": "6",
          "options": [
            "4",
            "6",
            "8",
            "10",
            "12",
            "20",
            "100"
          ]
        },
        {
          "key": "count",
          "type": "select",
          "label": "How many",
          "default": "1",
          "options": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ]
        }
