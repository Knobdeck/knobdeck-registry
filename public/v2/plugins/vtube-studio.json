      "yanked": false,
      "reason": null
    }
  ],
  "actions": {
    "hotkey": {
      "type": "button",
      "label": "Trigger Hotkey",
      "icon": "zap",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "hotkey",
          "type": "combobox",
          "label": "Hotkey"
        }
      ]
    },
    "model": {
      "type": "toggle",
      "label": "Load Model",
      "icon": "user-round",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "model",
          "type": "combobox",
          "label": "Model"
        }
      ],
      "states": [
        {
          "value": "other",
          "label": "Load Model",
          "icon": "user-round"
        },
        {
          "value": "loaded",
          "label": "Loaded",
          "icon": "circle-check"
        }
      ]
    },
    "expression": {
      "type": "toggle",
      "label": "Toggle Expression",
      "icon": "smile",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "expression",
          "type": "combobox",
          "label": "Expression"
        },
        {
          "key": "fade",
          "type": "text",
          "label": "Fade (seconds)",
          "default": "0.25"
        }
      ],
      "states": [
        {
          "value": "off",
          "label": "Expression Off",
          "icon": "meh"
        },
        {
          "value": "on",
          "label": "Expression On",
          "icon": "smile"
        }
      ]
    },
    "move-model": {
      "type": "slider",
      "label": "Move / Resize Model",
      "icon": "move",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "axis",
          "type": "select",
          "label": "What the dial changes",
          "default": "size",
          "options": [
            "size",
            "x",
            "y",
            "rotation"
          ]
        },
        {
          "key": "step",
          "type": "text",
          "label": "Step",
          "default": "2"
        }
      ],
      "min": -100,
      "max": 100,
      "step": 1,
      "unit": null
    },
    "parameter": {
      "type": "slider",
      "label": "Parameter Dial",
      "icon": "sliders-horizontal",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": [
        {
          "key": "parameter",
          "type": "combobox",
          "label": "Parameter"
        },
        {
          "key": "hold",
          "type": "checkbox",
          "label": "Keep the value (VTube Studio returns a parameter to tracking a second after the last value)",
          "default": true
        },
        {
          "key": "step",
          "type": "text",
          "label": "Step (%)",
          "default": "5"
        }
      ],
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    "current-model": {
      "type": "button",
      "label": "Current Model",
      "icon": "user-round",
      "platforms": [
        "macos",
        "windows"
      ],
      "inputs": []
    }
  },
  "companions": []
