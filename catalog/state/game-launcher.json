              "type": "select",
              "label": "Page",
              "default": "steam-library",
              "options": [
                "steam-library",
                "steam-store",
                "steam-friends",
                "steam-downloads",
                "steam-settings",
                "steam-bigpicture"
              ]
            }
          ]
        },
        "close": {
          "type": "button",
          "label": "Close Game",
          "icon": "circle-x",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "game",
              "type": "select",
              "label": "Game",
              "default": "__running__"
            },
            {
              "key": "force",
              "type": "select",
              "label": "If it doesn't close",
              "default": "5",
              "options": [
                "5",
                "15",
                "30",
                "never"
              ]
            }
          ]
        }
