            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "store",
              "type": "select",
              "label": "Store",
              "default": "all",
              "options": [
                "all",
                "steam",
                "heroic",
                "lutris"
              ]
            },
            {
              "key": "sort",
              "type": "select",
              "label": "Show",
              "default": "recent",
              "options": [
