      "actions": {
        "clock": {
          "type": "button",
          "label": "Clock",
          "icon": "clock",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "zone",
              "type": "combobox",
              "label": "Time zone",
              "default": "__local__"
            },
            {
              "key": "name",
              "type": "text",
              "label": "Name on the key (optional)"
            },
            {
              "key": "format",
              "type": "select",
              "label": "Format",
              "default": "24",
              "options": [
                "24",
                "12"
              ]
            },
            {
              "key": "date",
              "type": "checkbox",
              "label": "Show the date"
            }
          ]
        },
        "world-clock-wheel": {
          "type": "wheel",
          "label": "World Clock",
          "icon": "globe",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "zones",
              "type": "textarea",
              "label": "Time zones, one per line"
            },
            {
              "key": "format",
              "type": "select",
              "label": "Format",
              "default": "24",
              "options": [
                "24",
                "12"
              ]
            },
            {
              "key": "date",
              "type": "checkbox",
              "label": "Show the date"
            }
          ]
        },
        "timer": {
          "type": "button",
          "label": "Countdown Timer",
          "icon": "timer",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "length",
              "type": "text",
              "label": "Length",
              "default": "5m"
            },
            {
              "key": "to_file",
              "type": "checkbox",
              "label": "Write the time left to a text file (for an OBS text source)"
            },
            {
              "key": "file_path",
              "type": "text",
              "label": "Text file",
              "showIf": {
                "key": "to_file",
                "truthy": true
              }
            },
            {
              "key": "file_format",
              "type": "select",
              "label": "Format in the file",
              "default": "",
              "showIf": {
                "key": "to_file",
                "truthy": true
              },
              "options": [
                "",
                "mmss",
                "hhmmss"
              ]
            },
            {
              "key": "end_text",
              "type": "text",
              "label": "Text at zero (optional)",
              "showIf": {
                "key": "to_file",
                "truthy": true
              }
            }
          ]
        },
        "pomodoro": {
          "type": "button",
          "label": "Pomodoro",
          "icon": "timer",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "work",
              "type": "text",
              "label": "Work",
              "default": "25m"
            },
            {
              "key": "short",
              "type": "text",
              "label": "Short break",
              "default": "5m"
            },
            {
              "key": "long",
              "type": "text",
              "label": "Long break",
              "default": "15m"
            },
            {
              "key": "every",
              "type": "text",
              "label": "Long break every (work sessions)",
              "default": "4"
            },
            {
              "key": "auto",
              "type": "checkbox",
              "label": "Start the next phase on its own"
            },
            {
              "key": "name",
              "type": "text",
              "label": "Name (optional; links Pomodoro Skip / Reset keys)"
            }
          ]
        },
        "pomodoro-control": {
          "type": "button",
          "label": "Pomodoro Skip / Reset",
          "icon": "skip-forward",
          "platforms": [
            "linux",
            "macos",
            "windows"
          ],
          "inputs": [
            {
              "key": "op",
              "type": "select",
              "label": "Do",
              "default": "skip",
              "options": [
                "skip",
                "reset"
              ]
            },
            {
              "key": "name",
              "type": "text",
              "label": "Pomodoro name (as on its key; empty = unnamed ones)"
            }
          ]
        },
        "stopwatch": {
          "type": "button",
          "label": "Stopwatch",
          "icon": "timer-reset",
          "platforms": [
